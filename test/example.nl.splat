class Animal {}

class Cat < Animal {
  sayHi() : String {}
  sayHi(name : String) : String {}
}


class Octopus < Animal {
  tentacles : int = 8;
  color : String = "white";

  sayHi() : String {}
  sayHi(name : String) : String {}
}

class Dog < Animal {}
fn funcName(intArg : int, strArg : String) : void {
  return intArg + strArg;
}

fn doStuff() : void {
  return;
}

fn main() : int {
  doStuff();
  return 10;
}

fn sayHi(first : String, last : String, sayHi : String) : int {
  print "Hi, " + first + " " + last + "!";
  return 0;
}

var i : int = sayHi("Dear", "Reader");
