fn createArray() : int[5] {
  var arr : int[5];

  arr[0] = 5;
  arr[1] = 6;
  arr[2] = 7;
  arr[3] = -2;
  arr[4] = 0;

  return arr;
}

fn sumOfElems(list : int[5]) : int {
  var sum = 0;
  for (var i = 0; i < 5; i = i+1) {
    sum = sum + list[i];
  }
  return sum;
}

fn main() : int {
  print sumOfElems( createArray() );

  /*
  %output
  16
  %output
  */

  return 0;
}
