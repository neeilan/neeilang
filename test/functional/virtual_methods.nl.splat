class Animal {
  legs : int;
  hands : int;
  init(i : int) { return this; }
  sound() : void { print "animal!"; return; }

}
class Feline < Animal {
  i : int;
  init() { return this; }
  sound() : void { print "feline!"; return; }
}

class Cat < Feline {
  init() { return this; }
}


fn main() : int {
  var a : Animal = Animal.init(3);  
  a.sound();
  var f : Animal = Feline.init();  
  f.sound();
  var c : Animal = Cat.init();
  c.sound();
  return 0;
}

/*
%output
animal!
feline!
feline!
%output
*/
