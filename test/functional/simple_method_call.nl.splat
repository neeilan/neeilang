fn main() : int {
  var a : Animal = Animal.init();  
  print "init called successfully";
  a.notInit(1,2);
  a.getCat().meow();
  return 0;
}

class Animal {
  intField : int;
  floatField : float;
  init() {
    var x : int = 5;
    return this;
  }

  notInit(i : int, j : int) : void {
    print "notInit called";
    return;
  }

  getCat() : Cat { return Cat.init(); }
}

class Cat {
  init() { return this; }
  meow() : void { print "meow"; return; }
}

