class SomeClass {
  someField : int;

  init(f : int) {
    this.someField = f;
    return this;
  }

  getField() : int { return this.someField; }
}

fn main() : int {
  var myInt = 4;
  var myStr = "Inferred string";
  var myObj = SomeClass.init(33);

  print myInt;
  print myStr;
  print myObj.getField();

  return 0;
}

/*
%output
4
Inferred string
33
%output
*/
