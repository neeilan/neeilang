fn main() : int {
  var i : int; // Default value is 0

  while (i < 3) {
    // Try: var i : int; - couple ways to handle it.
    print i;
    i = i + 1;
  }

  var j : int = i;

  while (j > 0) {
    var k : int = 2;
    print j * k;
    j = j - 1;
  }

  return 0;
}

